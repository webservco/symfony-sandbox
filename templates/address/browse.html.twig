{% extends 'base.html.twig' %}

{% block title %}Addresses | {{ parent() }}{% endblock %}

{% block body %}
    <h2>Address list</h2>

    <div class="my-4">
        {% for address in pager %}
            <ul class="list-group">
                <li class="list-group-item">
                    {{ address.name }}
                    <a href="{{ path('app_address_show', {id: address.id}) }}">
                        [edit name]
                    </a>
                    <a href="{{ path('app_address_edit', {id: address.id}) }}">[edit full]</a>
                </li>
            </ul>
        {% endfor %}

    </div>
    <div class="my-4">
        {{ pagerfanta(pager) }}
    </div>

    <div class="my-4">
        <a
            href="{{ path('app_address_create') }}">Create</a>
    </div>

{% endblock %}
