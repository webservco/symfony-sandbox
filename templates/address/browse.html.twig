{% extends 'base.html.twig' %}

{% block title %}Addresses | {{ parent() }}{% endblock %}

{% block body %}
    <h2>Address list</h2>

    <div>
        {% for address in items %}
            <div>
                <h3>
                    <a href="{{ path('app_address_show', {id: address.id}) }}">
                        {{ address.name }}
                    </a>
                </h3>
            </div>
            <hr>
        {% endfor %}
    </div>
    <a href="{{ path('app_address_create') }}">Create</a>
{% endblock %}
