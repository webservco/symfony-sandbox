{% extends 'base.html.twig' %}

{% block title %}Address | {{ parent() }}{% endblock %}

{% block body %}
    <h2>{{ item.name }}</h2>

    <p>{{ item.allAddressLines }}</p>

    <hr>

    <form action="{{ path('app_address_edit_name', {id: item.id}) }}" method="post"
        class="">
        <div class="mb-4">
            <label class="form-label" for="username">
                Name
            </label>
            <input class="form-control"
                   type="text" name="name" value="{{ item.name }}" placeholder="Name">
        </div>

        <div class="">
            <button class="btn btn-dark"
                    name="submit" value="edit">
                Submit
            </button>
        </div>
    </form>

    <hr>

    <div class="my-4">
        <a class=""
           href="{{ path('app_address_browse') }}">Back</a>
    </div>

{% endblock %}
