{
    "description": "A Symfony sandbox project. Symfony 7.4 experiments in one app: Doctrine CRUD pages, an EasyAdmin dashboard, an API Platform API, registration and login, translations and Tabler layouts.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.0",
        "api-platform/symfony": "^4.0",
        "babdev/pagerfanta-bundle": "^4.4",
        "doctrine/dbal": "^3",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.2",
        "easycorp/easyadmin-bundle": "^4.12",
        "nelmio/cors-bundle": "^2.5",
        "pagerfanta/doctrine-orm-adapter": "^4.7",
        "pagerfanta/twig": "^4.7",
        "phpdocumentor/reflection-docblock": "^5.4",
        "phpstan/phpdoc-parser": "^2",
        "stof/doctrine-extensions-bundle": "^1.12",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^3.0",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^2.19",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-turbo": "^2.19",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/verify-email-bundle": "^1.17"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "phan/phan": "^6",
        "php-parallel-lint/php-console-highlighter": "^1",
        "php-parallel-lint/php-parallel-lint": "^1",
        "phpmd/phpmd": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-doctrine": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpunit/phpunit": "^13",
        "psalm/plugin-symfony": "^5",
        "slevomat/coding-standard": "^8",
        "squizlabs/php_codesniffer": "^4",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.61",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "vimeo/psalm": "^6",
        "vincentlanglet/twig-cs-fixer": "^3.1",
        "webservco/coding-standards": "^2",
        "weirdan/doctrine-psalm-plugin": "^2",
        "zenstruck/foundry": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "check:lint": "vendor/bin/parallel-lint bin config public src tests",
        "check:phan": "vendor/bin/phan --config-file vendor/webservco/coding-standards/phan/config.php --exclude-file config/bundles.php --exclude-file config/reference.php",
        "check:phpcs": "vendor/bin/phpcs --standard=.phpcs/php-coding-standard.xml --extensions=php -sp bin config public src tests --ignore=./config/bundles.php,./config/reference.php",
        "check:phpmd": "vendor/bin/phpmd analyze --no-progress --format json --ruleset vendor/webservco/coding-standards/phpmd/phpmd-rule-set.xml --exclude config/reference.php bin config public src tests",
        "check:phpstan": "vendor/bin/phpstan analyse bin config public src tests --ansi -c phpstan.dist.neon",
        "check:psalm": "vendor/bin/psalm --config=vendor/webservco/coding-standards/psalm/psalm-symfony-doctrine.xml --no-diff",
        "check:twig": "symfony console lint:twig templates && vendor/bin/twig-cs-fixer lint templates",
        "check": [
            "@check:lint",
            "@check:phpcs",
            "@check:twig",
            "@check:phpstan",
            "@check:phpmd",
            "@check:psalm",
            "@check:phan"
        ],
        "c": "@check",
        "fix:phpcs": "vendor/bin/phpcbf --standard=.phpcs/php-coding-standard.xml --extensions=php -sp bin config public src tests --ignore=./config/bundles.php,./config/reference.php",
        "fix:twig": "vendor/bin/twig-cs-fixer lint templates --fix",
        "test" : "XDEBUG_MODE=coverage vendor/bin/phpunit --colors=always --configuration vendor/webservco/coding-standards/phpunit/phpunit-13.xml",
        "test:dox" : "@test --testdox"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
